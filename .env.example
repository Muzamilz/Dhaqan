# PostgreSQL (Podman container "dev-postgres", published on 127.0.0.1:5432)
# Copy this file to .env and replace YOUR_PASSWORD with your actual Postgres password for user "dev".
DATABASE_URL="postgresql://dev:YOUR_PASSWORD@127.0.0.1:5432/app_dev?schema=public"